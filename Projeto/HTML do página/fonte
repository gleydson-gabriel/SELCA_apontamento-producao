</style></head><body><main><div class="account"><button id="accountToggle" title="Perfil" aria-label="Perfil" aria-expanded="false"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg></button><div id="accountMenu" hidden><select id="profile" aria-label="Perfil" hidden><option value="collaborator">Colaborador</option><option value="admin">Gleydson · Administrador</option></select><span id="accountName"></span><button id="logoutLocal">Sair</button></div></div><div id="message" role="status" aria-live="polite"></div><div id="app" hidden><section class="overview-panel"><div class="entry-panel"><div class="status" id="status" hidden></div><div class="row title-date"><h1 id="currentTitle">Apontamento de Produção</h1><time id="todayLabel"></time></div><p id="currentNote" class="muted"></p><div class="row between"><div class="clock" id="clock">00:00:00</div><span id="who" class="muted"></span></div><div class="row"><button class="primary" id="start">INICIAR</button><button class="pause" id="pause">PARAR</button><button id="finish">FINALIZAR</button></div></div><div class="summary-panel"><input id="date" type="hidden"><div class="metrics"><div class="card"><span class="muted">Tempo trabalhado</span><div id="worked" class="metric">00:00:00</div></div><div class="card"><span class="muted">Tempo em pausa</span><div id="paused" class="metric">00:00:00</div></div><div class="card"><span class="muted">Tempo total</span><div id="totalTime" class="metric">00:00:00</div></div></div><div class="availability"><span class="muted">Disponibilidade</span><strong id="availability" title="Tempo trabalhado ÷ (trabalho + pausas)">—</strong></div></div></section><section><div class="row zoom-tools" role="group" aria-label="Zoom da linha do tempo"><button id="zoomOut" aria-label="Diminuir zoom">−</button><span id="zoomValue" aria-live="polite">24 h na tela