<dialog id="authDialog"><h2 id="authTitle">Entrar</h2><form id="loginLocalForm"><label>Login<input id="loginUser" autocomplete="username" required></label><label>Senha<input id="loginPassword" type="password" autocomplete="current-password" required></label><button class="primary">Entrar</button></form><form id="setupLocalForm" hidden><p class="muted" style="font-size:14px">Crie os dois acessos para este protótipo local.</p><div class="login-section"><h3>Administrador</h3><label>Login<input id="setupAdmin" autocomplete="username" value="admin" required></label><label>Senha<input id="setupAdminPassword" type="password" autocomplete="new-password" minlength="8" required></label></div><div class="login-section"><h3>Colaborador</h3><label>Login<input id="setupWorker" autocomplete="username" value="colaborador" required></label><label>Senha<input id="setupWorkerPassword" type="password" autocomplete="new-password" minlength="8" required></label></div><button class="primary">Criar acessos</button></form><p id="authError" role="alert"></p></dialog><dialog id="startDialog"><form id="startForm"><h2>Iniciar atividade</h2><p class="muted">O horário do clique em INICIAR será usado ao confirmar. Cancelar descarta o início.</p><label>Tarefa<select id="taskSelect" required></select></label><label>O que você irá fazer?<textarea id="note" maxlength="500" required placeholder="Ex.: Proposta para o cliente... "></textarea></label><div class="row"><button type="button" data-close="startDialog">Cancelar</button><button class="primary">Confirmar início</button></div></form></dialog>
<dialog id="pauseDialog"><form id="pauseForm"><h2>Atividade pausada</h2><p class="muted">A contagem já foi interrompida. O motivo é opcional.</p><label>Motivo da parada<textarea id="reason" maxlength="500"></textarea></label><div class="row"><button type="button" data-close="pauseDialog">Fechar sem motivo</button><button class="primary">Salvar motivo</button></div></form></dialog>
<dialog id="editDialog"><form id="editForm"><h2>Editar horários</h2><p id="editTitle" class="muted"></p><p class="muted" style="font-size:14px">Horário de Brasília. As pausas internas serão preservadas. A alteração ficará registrada no histórico.</p><label>Início<input id="editStart" type="datetime-local" step="1" required></label><label>Fim<input id="editEnd" type="datetime-local" step="1" required></label><p id="editError" role="alert" style="color:#a02b2b"></p><div class="row"><button type="button" data-close="editDialog">Cancelar</button><button class="primary">Salvar alteração</button></div></form></dialog><dialog id="detailDialog"><h2>Detalhes do intervalo</h2><div id="detailText"></div><button data-close="detailDialog" style="margin-top:20px">Fechar</button></dialog><script>
'use strict';
const $=id=>document.getElementById(id), STORAGE='horas-prototipo-v1';
const colors=['#1643d1','#007f77','#7b40bf','#b55712','#b63066'];
let data, busy=false, pauseId=null, pendingStart=null;
const now=()=>Date.now();
