function makeXls(rows){if(rows.length>16384)throw new Error('O formato .xls desta versão aceita até 16.384 linhas por exportação.');const chunks=[];function record(id,payload){const h=new Uint8Array(4),v=new DataView(h.buffer);v.setUint16(0,id,true);v.setUint16(2,payload.length,true);chunks.push(h,payload);}record(9,new Uint8Array([2,0,16,0]));rows.forEach((row,r)=>row.forEach((value,c)=>{if(typeof value==='number'&&Number.isFinite(value)){const p=new Uint8Array(15),v=new DataView(p.buffer);v.setUint16(0,r,true);v.setUint16(2,c,true);v.setFloat64(7,value,true);record(3,p);}else{const text=String(value??'').replace(/[–—]/g,'-').replace(/→/g,'>').slice(0,255),p=new Uint8Array(8+text.length),v=new DataView(p.buffer);v.setUint16(0,r,true);v.setUint16(2,c,true);p[7]=text.length;for(let i=0;i<text.length;i++)p[8+i]=text.charCodeAt(i)<=255?text.charCodeAt(i):63;record(4,p);}}));record(10,new Uint8Array());return new Blob(chunks,{type:'application/vnd.ms-excel'});}
